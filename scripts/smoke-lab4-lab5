#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
tripgoctl=${TRIPGOCTL:-"$root/build/bin/tripgoctl-stage9"}
for command in curl docker go grep jq; do
	command -v "$command" >/dev/null 2>&1 || { echo "stage9 smoke requires $command" >&2; exit 3; }
done
if "$tripgoctl" cluster status >/dev/null 2>&1; then
	echo "stage9 smoke requires no existing tripgo-local cluster" >&2
	exit 4
fi
work=$(mktemp -d "${TMPDIR:-/tmp}/tripgo-stage9-smoke.XXXXXX")
cleanup_done=0
cleanup() {
	if [ "$cleanup_done" -eq 0 ]; then
		if "$tripgoctl" cluster stop --yes >/dev/null 2>&1; then
			cleanup_done=1
		else
			echo "warning: failure-path cleanup could not remove tripgo-local" >&2
		fi
	fi
	rm -rf "$work"
}
trap cleanup EXIT
trap 'exit 1' HUP INT TERM
for lab in 4 5; do
	mkdir -p "$work/lab$lab"
	cat >"$work/lab$lab/environment.toml" <<EOF
schema_version = 1
lab = $lab
components = ["postgres", "observability", "push", "redpanda"]
EOF
done
kubectl_in_node() {
	docker exec tripgo-local-control-plane kubectl --kubeconfig=/etc/kubernetes/admin.conf "$@"
}
partition_count() {
	namespace=$1 topic=$2
	kubectl_in_node -n "$namespace" exec redpanda-0 -c redpanda -- rpk topic describe "$topic" -p --brokers redpanda:9092 |
		awk '$1 ~ /^[0-9]+$/ {count++} END {print count+0}'
}
assert_topics() {
	namespace=$1
	test "$(partition_count "$namespace" trip.events.v1)" = 3
	test "$(partition_count "$namespace" trip.commands.v1)" = 3
	test "$(partition_count "$namespace" trip.commands.v1.dlq)" = 1
}

"$tripgoctl" cluster start
for lab in 4 5; do
	(
		cd "$work/lab$lab"
		"$tripgoctl" environment start
		"$tripgoctl" environment status | grep -F 'Status:      ready' >/dev/null
		kafka_port=$((20000 + lab * 1000 + 92))
		"$tripgoctl" connect | grep -F "Kafka       localhost:$kafka_port" >/dev/null
		grep -F "BROKER_BROKERS=localhost:$kafka_port" .env >/dev/null
	)
done
assert_topics tripgo-lab-04
assert_topics tripgo-lab-05
# Reconcile both a missing topic and an existing topic with too few partitions.
kubectl_in_node -n tripgo-lab-04 exec redpanda-0 -c redpanda -- rpk topic delete trip.commands.v1 trip.commands.v1.dlq --brokers redpanda:9092 >/dev/null
kubectl_in_node -n tripgo-lab-04 exec redpanda-0 -c redpanda -- rpk topic create trip.commands.v1 --partitions 1 --replicas 1 --brokers redpanda:9092 >/dev/null
attempt=0
until test "$(partition_count tripgo-lab-04 trip.commands.v1)" = 3 && test "$(partition_count tripgo-lab-04 trip.commands.v1.dlq)" = 1; do
	attempt=$((attempt + 1)); [ "$attempt" -lt 30 ] || exit 1; sleep 2
done
for lab in 4 5; do
	port=$((20000 + lab * 1000 + 81))
	curl -fsS "http://localhost:$port/admin/health" >/dev/null
	curl -fsS "http://localhost:$port/api/topics" | jq -e '
		def partitions: (.partitionCount // .partitions // .partition_count);
		(if type == "array" then . else .topics end) as $topics |
		any($topics[]; (.topicName // .name) == "trip.events.v1" and partitions == 3) and
		any($topics[]; (.topicName // .name) == "trip.commands.v1" and partitions == 3) and
		any($topics[]; (.topicName // .name) == "trip.commands.v1.dlq" and partitions == 1)' >/dev/null
	done
(cd "$root" && go run ./tests/kafka-smoke -endpoint localhost:24092 -group stage9-lab4 -message only-lab4)
(cd "$root" && go run ./tests/kafka-smoke -endpoint localhost:25092 -group stage9-lab5 -message only-lab5)
kubectl_in_node -n tripgo-lab-04 exec redpanda-0 -c redpanda -- rpk group list --brokers redpanda:9092 | grep -F stage9-lab4 >/dev/null
if kubectl_in_node -n tripgo-lab-05 exec redpanda-0 -c redpanda -- rpk group list --brokers redpanda:9092 | grep -F stage9-lab4 >/dev/null; then
	echo 'lab 4 consumer group leaked into lab 5' >&2; exit 1
fi

(cd "$work/lab4" && "$tripgoctl" environment start >/dev/null) # idempotent topic reconciliation
(cd "$work/lab4" && "$tripgoctl" environment stop | grep -F 'Status:      stopped' >/dev/null)
(cd "$work/lab5" && "$tripgoctl" environment status | grep -F 'Status:      ready' >/dev/null)
(cd "$work/lab4" && "$tripgoctl" environment start | grep -F 'Status:      ready' >/dev/null)
(cd "$root" && go run ./tests/kafka-smoke -endpoint localhost:24092 -group stage9-persistence-read -message only-lab4 -expected-key stage9-lab4 -publish=false)

(cd "$work/lab4" && "$tripgoctl" environment reset --yes)
(cd "$work/lab4" && "$tripgoctl" environment start >/dev/null)
assert_topics tripgo-lab-04
if (cd "$root" && go run ./tests/kafka-smoke -endpoint localhost:24092 -group stage9-reset-read -message only-lab4 -expected-key stage9-lab4 -publish=false -timeout=5s); then
	echo 'lab 4 record survived reset' >&2; exit 1
fi
(cd "$work/lab5" && "$tripgoctl" environment reset --yes)
(cd "$work/lab4" && "$tripgoctl" environment reset --yes)

# Cleanup is part of the gate: success must never be printed while managed
# cluster or registry containers still exist.
"$tripgoctl" cluster stop --yes
if docker ps -a --format '{{.Names}}' | grep -E '^(tripgo-local-control-plane|tripgo-local-registry)$' >/dev/null; then
	echo "stage9 cleanup left managed containers behind" >&2
	exit 1
fi
cleanup_done=1
rm -rf "$work"
echo "stage9 labs 4/5 Redpanda integration smoke passed"
