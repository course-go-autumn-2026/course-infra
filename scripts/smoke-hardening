#!/bin/sh
set -eu

# Isolated stage-11 fault gate. It models daemon failures using Go test temp
# directories without mutating Docker or Kubernetes.
root=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
cd "$root"

./scripts/sync-contracts check

test -L api/openapi/push-service.openapi.yaml
test "$(readlink api/openapi/push-service.openapi.yaml)" = "../../third_party/homework/contracts/openapi/push-service.openapi.yaml"
test -L api/proto/push/v1/push.proto
test "$(readlink api/proto/push/v1/push.proto)" = "../../../../third_party/homework/contracts/proto/push/v1/push.proto"

go test ./internal/cluster ./internal/lab ./internal/redact ./internal/cli \
  -run 'Cancellation|Canceled|FailedStartCleanup|InterruptedLocalState|WarmedCacheOffline|OperationLock|AdditivePatchMinor|Doctor|Readiness|Redact|PartialNamespace|Foreign|Drift|Atomically' \
  -count=1

# Package-local release staging must always be cleaned outside a gated build.
test ! -e internal/pushartifact/generated
test ! -e internal/contractasset/generated
