#!/bin/sh
# Run the complete release gate and remove publishable output after any failure.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if "$root/scripts/build-release"; then
	:
else
	status=$?
	rm -rf "$root/build/release"
	exit "$status"
fi
if "$root/scripts/audit-release-cleanup"; then
	:
else
	status=$?
	rm -rf "$root/build/release"
	exit "$status"
fi
