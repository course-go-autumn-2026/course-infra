#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
tripgoctl=${TRIPGOCTL:-"$root/build/bin/tripgoctl"}

for command in docker psql goose shasum; do
	if ! command -v "$command" >/dev/null 2>&1; then
		echo "lifecycle integration requires $command" >&2
		exit 3
	fi
done

if "$tripgoctl" cluster status >/dev/null 2>&1; then
	echo "lifecycle integration requires no existing tripgo-local cluster" >&2
	exit 4
fi

work=$(mktemp -d "${TMPDIR:-/tmp}/tripgo-lifecycle-integration.XXXXXX")
cleanup() {
	"$tripgoctl" cluster stop --yes >/dev/null 2>&1 || true
	rm -rf "$work"
}
trap cleanup EXIT HUP INT TERM

cat >"$work/environment.toml" <<'EOF'
schema_version = 1
lab = 1
components = ["postgres"]

[env]
A_CUSTOM = "enabled"
Z_LITERAL = "${UNCHANGED}"
EOF

"$tripgoctl" cluster start
cat >"$work/spoof-kubeconfig" <<'EOF'
apiVersion: v1
kind: Config
clusters:
  - name: spoof
    cluster:
      server: https://127.0.0.1:1
      insecure-skip-tls-verify: true
contexts:
  - name: kind-tripgo-local
    context:
      cluster: spoof
      user: spoof
current-context: kind-tripgo-local
users:
  - name: spoof
    user: {}
EOF
export KUBECONFIG="$work/spoof-kubeconfig"
(
	cd "$work"
	"$tripgoctl" environment start

	# A foreign SSA manager that force-owns replicas must cause start to
	# conflict without changing the foreign value.
	cat <<'EOF' | docker exec -i tripgo-local-control-plane kubectl --kubeconfig=/etc/kubernetes/admin.conf apply \
		--server-side --force-conflicts --field-manager=lifecycle-integration-foreign-manager -f -
apiVersion: apps/v1
kind: Deployment
metadata:
  name: postgres
  namespace: tripgo-lab-01
spec:
  replicas: 0
EOF
	if "$tripgoctl" environment start; then
		echo 'environment start overwrote foreign SSA ownership of spec.replicas' >&2
		exit 1
	fi
	test "$(docker exec tripgo-local-control-plane kubectl --kubeconfig=/etc/kubernetes/admin.conf \
		-n tripgo-lab-01 get deployment postgres -o 'jsonpath={.spec.replicas}')" = 0
	"$tripgoctl" environment reset --yes

	"$tripgoctl" environment start
	"$tripgoctl" environment start
	"$tripgoctl" environment list | grep -F '01   tripgo-lab-01   ready' >/dev/null
	"$tripgoctl" cluster status | grep -F 'Environments: 1 known, 1 running' >/dev/null

	before=$(find .env .tripgo -type f -exec shasum -a 256 {} + | sort | shasum -a 256 | cut -d' ' -f1)
	"$tripgoctl" connect
	after=$(find .env .tripgo -type f -exec shasum -a 256 {} + | sort | shasum -a 256 | cut -d' ' -f1)
	test "$before" = "$after"
	grep -F 'A_CUSTOM=enabled' .env >/dev/null
	grep -F 'Z_LITERAL=${UNCHANGED}' .env >/dev/null

	database_url=$(sed -n 's/^DATABASE_URL=//p' .env)
	migrations="$work/migrations"
	mkdir "$migrations"
	cat >"$migrations/000001_integration.sql" <<'SQL'
-- +goose Up
CREATE TABLE lifecycle_integration_data (id bigint PRIMARY KEY, value text NOT NULL);
INSERT INTO lifecycle_integration_data VALUES (1, 'persisted');
-- +goose Down
DROP TABLE lifecycle_integration_data;
SQL
	goose -env=none -dir "$migrations" postgres "$database_url" up
	test "$(psql "$database_url" -Atc 'SELECT value FROM lifecycle_integration_data WHERE id = 1')" = persisted
	"$tripgoctl" environment stop
	"$tripgoctl" cluster status | grep -F 'Environments: 1 known, 0 running' >/dev/null
	"$tripgoctl" environment start
	test "$(psql "$database_url" -Atc 'SELECT value FROM lifecycle_integration_data WHERE id = 1')" = persisted
	goose -env=none -dir "$migrations" postgres "$database_url" down
	psql "$database_url" -v ON_ERROR_STOP=1 -c 'DROP TABLE goose_db_version;'

	"$tripgoctl" environment reset --yes
	"$tripgoctl" cluster status | grep -F 'Environments: 0 known, 0 running' >/dev/null
	printf 'USER_OWNED=yes\n' >.env
	if "$tripgoctl" environment start; then
		echo 'environment start overwrote a user .env' >&2
		exit 1
	fi
	test "$(cat .env)" = USER_OWNED=yes
	rm .env
	"$tripgoctl" environment start
	test "$(psql "$database_url" -Atc "SELECT to_regclass('public.lifecycle_integration_data') IS NULL")" = t
	"$tripgoctl" environment reset --yes
)

echo "lifecycle integration passed"
