#!/bin/sh
set -eu

# Parse the complete function before doing any work when invoked through curl | sh.
main() {
repository="${TRIPGOCTL_REPOSITORY:-course-go-autumn-2026/course-infra}"
base_url="${TRIPGOCTL_BASE_URL:-https://github.com/${repository}/releases/download}"
release_dir="${TRIPGOCTL_RELEASE_DIR:-}"
install_dir="${TRIPGOCTL_INSTALL_DIR:-}"
version=""

usage() {
    cat <<'EOF'
Usage: install-tripgoctl [--install-dir DIR] [VERSION]

Install a verified tripgoctl release on macOS or Linux (amd64/arm64).
VERSION defaults to latest (the newest successfully published main build).

Environment:
  TRIPGOCTL_INSTALL_DIR   Installation directory (overrides the default)
  TRIPGOCTL_RELEASE_DIR   Local archive directory (requires an explicit VERSION)
  TRIPGOCTL_BASE_URL      Download base URL (requires an explicit VERSION)
  TRIPGOCTL_REPOSITORY    GitHub owner/repository used by the default URL

Examples:
  ./scripts/install-tripgoctl
  ./scripts/install-tripgoctl v1.0.0
  ./scripts/install-tripgoctl --install-dir "$HOME/.local/bin" v1.0.0
  TRIPGOCTL_RELEASE_DIR=build/release ./scripts/install-tripgoctl v1.0.0
EOF
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --install-dir)
            [ "$#" -ge 2 ] || { echo "--install-dir requires a value" >&2; exit 2; }
            install_dir=$2
            shift 2
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        --)
            shift
            break
            ;;
        -*)
            echo "unknown option: $1" >&2
            usage >&2
            exit 2
            ;;
        *)
            [ -z "$version" ] || { echo "only one VERSION may be specified" >&2; exit 2; }
            version=$1
            shift
            ;;
    esac
done

[ "$#" -eq 0 ] || { echo "unexpected argument: $1" >&2; exit 2; }
version=${version:-latest}
if [ -z "$release_dir" ]; then
    case "$base_url" in
        https://*) ;;
        *) echo "TRIPGOCTL_BASE_URL must use https://" >&2; exit 1 ;;
    esac
    command -v curl >/dev/null 2>&1 || {
        echo "curl is required to download tripgoctl" >&2
        exit 1
    }
fi
if [ "$version" = latest ]; then
    if [ -n "$release_dir" ] || [ -n "${TRIPGOCTL_BASE_URL:-}" ]; then
        echo "an explicit VERSION is required with TRIPGOCTL_RELEASE_DIR or TRIPGOCTL_BASE_URL" >&2
        exit 2
    fi
    # Resolve once: a concurrent release must not mix an archive with another manifest.
    resolved=$(curl --fail --location --silent --show-error --proto '=https' --proto-redir '=https' --tlsv1.2 \
        --output /dev/null --write-out '%{url_effective}' \
        "https://github.com/${repository}/releases/latest")
    tag_url="https://github.com/${repository}/releases/tag/"
    case "$resolved" in
        "$tag_url"*) version=${resolved#"$tag_url"} ;;
        *) echo "could not resolve latest release: $resolved" >&2; exit 1 ;;
    esac
    [ "$version" != latest ] || { echo "latest did not resolve to a release tag" >&2; exit 1; }
fi
case "$version" in
    ''|[!0-9A-Za-z]*|*[!0-9A-Za-z._+-]*)
        echo "invalid VERSION: $version" >&2
        exit 2
        ;;
esac

case "$(uname -s)" in
    Darwin) os=darwin ;;
    Linux) os=linux ;;
    *) echo "unsupported operating system: $(uname -s)" >&2; exit 1 ;;
esac
case "$(uname -m)" in
    x86_64|amd64) arch=amd64 ;;
    arm64|aarch64) arch=arm64 ;;
    *) echo "unsupported architecture: $(uname -m)" >&2; exit 1 ;;
esac

if [ -z "$install_dir" ]; then
    if [ -d /usr/local/bin ] && [ -w /usr/local/bin ]; then
        install_dir=/usr/local/bin
    else
        install_dir=${HOME:?HOME is required}/.local/bin
    fi
fi

archive="tripgoctl_${version}_${os}_${arch}.tar.gz"
tmp=$(mktemp -d "${TMPDIR:-/tmp}/tripgoctl-install.XXXXXX")
destination_tmp=""
cleanup() {
    rm -rf "$tmp"
    if [ -n "$destination_tmp" ]; then
        rm -f "$destination_tmp"
    fi
}
trap cleanup EXIT HUP INT TERM

if [ -n "$release_dir" ]; then
    cp "$release_dir/$archive" "$tmp/$archive"
    cp "$release_dir/SHA256SUMS" "$tmp/SHA256SUMS"
else
    curl --fail --location --silent --show-error --proto '=https' --proto-redir '=https' --tlsv1.2 \
        "$base_url/$version/$archive" -o "$tmp/$archive"
    curl --fail --location --silent --show-error --proto '=https' --proto-redir '=https' --tlsv1.2 \
        "$base_url/$version/SHA256SUMS" -o "$tmp/SHA256SUMS"
fi

expected=$(awk -v name="$archive" '
    $2 == name { count++; digest=$1 }
    END { if (count == 1) print digest }
' "$tmp/SHA256SUMS")
printf '%s' "$expected" | grep -Eq '^[0-9a-fA-F]{64}$' || {
    echo "SHA256SUMS does not contain exactly one valid entry for $archive" >&2
    exit 1
}

if command -v sha256sum >/dev/null 2>&1; then
    actual=$(sha256sum "$tmp/$archive" | awk '{print $1}')
elif command -v shasum >/dev/null 2>&1; then
    actual=$(shasum -a 256 "$tmp/$archive" | awk '{print $1}')
else
    echo "sha256sum or shasum is required" >&2
    exit 1
fi
[ "$actual" = "$expected" ] || {
    echo "checksum mismatch for $archive" >&2
    exit 1
}

tar -xzf "$tmp/$archive" -C "$tmp" tripgoctl
[ -f "$tmp/tripgoctl" ] && [ ! -L "$tmp/tripgoctl" ] || {
    echo "archive does not contain a regular tripgoctl file" >&2
    exit 1
}

mkdir -p "$install_dir"
[ -d "$install_dir" ] && [ -w "$install_dir" ] || {
    echo "installation directory is not writable: $install_dir" >&2
    echo "choose a writable directory with --install-dir" >&2
    exit 1
}
destination_tmp=$(mktemp "$install_dir/.tripgoctl.new.XXXXXX")
install -m 0755 "$tmp/tripgoctl" "$destination_tmp"
mv -f "$destination_tmp" "$install_dir/tripgoctl"
destination_tmp=""

echo "Installed tripgoctl $version to $install_dir/tripgoctl"
case ":${PATH:-}:" in
    *":$install_dir:"*) ;;
    *)
        echo "Add the installation directory to PATH:" >&2
        echo "  export PATH=\"$install_dir:\$PATH\"" >&2
        ;;
esac
}

main "$@"
