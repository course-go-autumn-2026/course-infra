#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
tripgoctl=${TRIPGOCTL:-"$root/build/bin/tripgoctl-embedded"}
for command in curl docker go grep jq; do
	command -v "$command" >/dev/null 2>&1 || { echo "release runtime integration requires $command" >&2; exit 3; }
done
if "$tripgoctl" cluster status >/dev/null 2>&1; then
	echo "release runtime integration requires no existing tripgo-local cluster" >&2
	exit 4
fi
work=$(mktemp -d "${TMPDIR:-/tmp}/tripgo-release-runtime-integration.XXXXXX")
cleanup() {
	"$tripgoctl" cluster stop --yes >/dev/null 2>&1 || true
	rm -rf "$work"
}
trap cleanup EXIT HUP INT TERM
cat >"$work/environment.toml" <<'EOF'
schema_version = 1
lab = 3
components = ["postgres", "observability", "push"]
EOF
request='{"request_id":"release-runtime-http","recipient_id":"8860b315-ec86-42eb-a17c-7c163d721ff5","kind":"REQUEST_POSITION","data":{"trip_id":"1f0a9c62-4a1c-4f2e-9d33-2a4bb0f0b111"}}'
post_status() {
	url=$1 payload=$2
	curl -sS -o "$work/body" -D "$work/headers" -w '%{http_code}' -H 'Content-Type: application/json' --data-binary "$payload" "$url"
}

"$tripgoctl" cluster start
(
	cd "$work"
	"$tripgoctl" environment start
	"$tripgoctl" environment status | grep -F 'Status:      ready' >/dev/null
	"$tripgoctl" environment list | grep -F 'push-service' >/dev/null
	"$tripgoctl" connect | grep -F 'Push HTTP   http://localhost:23809' >/dev/null
	"$tripgoctl" connect | grep -F 'Push gRPC   localhost:23905' >/dev/null
	grep -F 'PUSH_HTTP_URL=http://localhost:23809' .env >/dev/null

	push_ref=$(docker exec tripgo-local-control-plane kubectl --kubeconfig=/etc/kubernetes/admin.conf \
		-n tripgo-lab-03 get deployment push-service -o jsonpath='{.spec.template.spec.containers[0].image}')
	printf '%s\n' "$push_ref" | grep -E '^localhost:5001/tripgo-push-service@sha256:[0-9a-f]{64}$' >/dev/null
	docker exec tripgo-local-control-plane crictl inspecti "$push_ref" >/dev/null
	curl -fsS http://localhost:23809/health >/dev/null
	test "$(post_status http://localhost:23809/api/v1/push "$request")" = 202
	(cd "$root" && go run ./tests/integration/push-grpc-client -endpoint localhost:23905 -expect success)

	test "$(post_status http://localhost:23809/admin/behaviour '{"fail_rate":1}')" = 200
	test "$(post_status http://localhost:23809/api/v1/push "$request")" = 503
	test "$(post_status http://localhost:23809/admin/behaviour '{"fail_rate":0,"latency_ms":1000}')" = 200
	(cd "$root" && go run ./tests/integration/push-grpc-client -endpoint localhost:23905 -timeout 50ms -expect deadline)
	test "$(post_status http://localhost:23809/admin/behaviour '{"latency_ms":0,"rate_limit_rps":1}')" = 200
	test "$(post_status http://localhost:23809/api/v1/push "$request")" = 202
	rate_status=202
	attempt=0
	while [ "$rate_status" = 202 ] && [ "$attempt" -lt 50 ]; do
		rate_status=$(post_status http://localhost:23809/api/v1/push "$request")
		attempt=$((attempt + 1))
	done
	test "$rate_status" = 429

	"$tripgoctl" environment logs push-service --tail 100 | grep -E '"result":"(accepted|rate_limited|injected_failure)"' >/dev/null
	docker exec tripgo-local-control-plane kubectl --kubeconfig=/etc/kubernetes/admin.conf -n tripgo-lab-03 delete pod -l app.kubernetes.io/name=push-service >/dev/null
	attempt=0
	until curl -fsS http://localhost:23809/health >/dev/null 2>&1; do
		attempt=$((attempt + 1)); [ "$attempt" -lt 60 ] || exit 1; sleep 2
	done
	# In-memory admin settings reset to manifest env defaults after pod restart.
	test "$(post_status http://localhost:23809/api/v1/push "$request")" = 202

	"$tripgoctl" environment stop | grep -F 'Status:      stopped' >/dev/null
	"$tripgoctl" environment start | grep -F 'Status:      ready' >/dev/null
	"$tripgoctl" environment reset --yes
)
# The implementation has no configurable repository and the registry contains only the local name.
curl -fsS http://localhost:5001/v2/_catalog | jq -e '.repositories | all(. == "tripgo-push-service")' >/dev/null

echo "release runtime integration passed"
