#!/usr/bin/env python3
"""Build deterministic, local-only tripgoctl release archives."""

from __future__ import annotations

import argparse
import gzip
import hashlib
import json
import os
import re
import shutil
import stat
import subprocess
import sys
import tarfile
import tempfile
from datetime import datetime, timezone
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
RELEASE = ROOT / "build" / "release"
PUSH_STAGE = ROOT / "internal" / "pushartifact" / "generated"
CONTRACT_STAGE = ROOT / "internal" / "contractasset" / "generated"
PLATFORMS = (("darwin", "amd64"), ("darwin", "arm64"), ("linux", "amd64"), ("linux", "arm64"))
BUILDINFO = "github.com/course-go-autumn-2026/tripgo-infra/internal/buildinfo"


def run(arguments: list[str], env: dict[str, str] | None = None) -> None:
    print("+ " + " ".join(arguments), flush=True)
    subprocess.run(arguments, cwd=ROOT, env=env, check=True)


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as source:
        for chunk in iter(lambda: source.read(128 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def require_clean_superproject() -> None:
    result = subprocess.run(
        ["git", "status", "--porcelain=v1", "--untracked-files=all"],
        cwd=ROOT,
        check=True,
        capture_output=True,
        text=True,
    )
    if result.stdout:
        paths = [line[3:] for line in result.stdout.splitlines()]
        raise ValueError(
            "release requires a clean superproject index and worktree; changed paths: "
            + ", ".join(paths)
        )


def source_value(path: Path, pattern: str, description: str) -> str:
    match = re.search(pattern, path.read_text())
    if not match:
        raise ValueError(f"cannot read {description} from {path.relative_to(ROOT)}")
    return match.group(1)


def release_notes(version: str, commit: str, built_at: str) -> bytes:
    constants = ROOT / "internal" / "cluster" / "constants.go"
    images_source = (ROOT / "internal" / "catalog" / "images.go").read_text()
    kind = source_value(constants, r'KindVersion\s+=\s+"([^"]+)"', "kind version")
    kubernetes = source_value(constants, r'KubernetesVersion\s+=\s+"([^"]+)"', "Kubernetes version")
    node = source_value(constants, r'KindNodeImage\s+=\s+"([^"]+)"', "kind node image")
    manifest = json.loads((ROOT / "api" / "source.json").read_text())
    source_commit = manifest["source_commit"]
    contract_hashes = [(item["destination"], item["sha256"]) for item in manifest["files"]]
    images = re.findall(r'\{Name: "([^"]+)", Repository: "([^"]+)", Tag: "([^"]+)", Digest: "([^"]+)"', images_source)
    lines = [
        f"# tripgoctl {version} release inventory",
        "",
        "Self-contained CLI archives. CI publishes verified main builds to GitHub Releases; no remote Push Service OCI image is published.",
        "",
        f"- Build commit: `{commit}`",
        f"- Reproducible build timestamp: `{built_at}`",
        f"- Embedded Push Service: `{version}` (`linux/amd64` or `linux/arm64`, matched to CLI architecture)",
        f"- kind: `{kind}`",
        f"- Kubernetes: `{kubernetes}`",
        f"- kind node image: `{node}`",
        f"- Canonical Push contract commit: `{source_commit}`",
        "- Runtime Dockerfile: `FROM scratch`, non-root UID/GID `65532:65532`",
        "",
        "## Canonical contract SHA-256",
        "",
    ]
    lines.extend(f"- `{destination}`: `{digest}`" for destination, digest in contract_hashes)
    lines.extend(["", "## External OCI inventory", ""])
    lines.extend(f"- `{name}`: `{repository}:{tag}@{digest}`" for name, repository, tag, digest in images)
    lines.extend([
        "",
        "The Push Service has no remote OCI reference. Each CLI builds it locally and pushes only to `localhost:5001/tripgo-push-service`, then consumes its RepoDigest.",
        "",
        "SBOM/provenance are deferred: no pinned deterministic generator is part of v1. They must not be emitted with host- or time-dependent metadata.",
        "",
    ])
    return "\n".join(lines).encode()


def add_bytes(archive: tarfile.TarFile, name: str, content: bytes, mode: int, epoch: int) -> None:
    info = tarfile.TarInfo(name)
    info.size = len(content)
    info.mode = mode
    info.mtime = epoch
    info.uid = info.gid = 0
    info.uname = info.gname = "root"
    archive.addfile(info, __import__("io").BytesIO(content))


def create_archive(path: Path, binary: bytes, notes: bytes, epoch: int) -> None:
    with path.open("wb") as destination:
        with gzip.GzipFile(filename="", mode="wb", fileobj=destination, mtime=epoch) as compressed:
            with tarfile.open(fileobj=compressed, mode="w", format=tarfile.PAX_FORMAT) as archive:
                add_bytes(archive, "tripgoctl", binary, 0o755, epoch)
                add_bytes(archive, "RELEASE_NOTES.md", notes, 0o644, epoch)
                add_bytes(archive, "LICENSE", (ROOT / "LICENSE").read_bytes(), 0o644, epoch)


def audit_archive(path: Path, expected_binary: bytes, expected_notes: bytes) -> None:
    with tarfile.open(path, "r:gz") as archive:
        members = archive.getmembers()
        if [member.name for member in members] != ["tripgoctl", "RELEASE_NOTES.md", "LICENSE"]:
            raise ValueError(f"{path.name}: unexpected archive inventory")
        if stat.S_IMODE(members[0].mode) != 0o755 or not members[0].isfile():
            raise ValueError(f"{path.name}: tripgoctl is not a regular executable")
        if archive.extractfile(members[0]).read() != expected_binary:  # type: ignore[union-attr]
            raise ValueError(f"{path.name}: archived CLI differs from verified final binary")
        if archive.extractfile(members[1]).read() != expected_notes:  # type: ignore[union-attr]
            raise ValueError(f"{path.name}: release notes differ")
        if archive.extractfile(members[2]).read() != (ROOT / "LICENSE").read_bytes():  # type: ignore[union-attr]
            raise ValueError(f"{path.name}: license differs")


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--version", default=os.environ.get("VERSION", "dev"))
    parser.add_argument("--commit", default=os.environ.get("COMMIT", "unknown"))
    parser.add_argument("--source-date-epoch", type=int, default=int(os.environ.get("SOURCE_DATE_EPOCH", "0")))
    args = parser.parse_args()
    if not re.fullmatch(r"[0-9A-Za-z][0-9A-Za-z._+-]*", args.version):
        parser.error("version contains unsafe archive-name characters")
    if args.source_date_epoch < 0:
        parser.error("SOURCE_DATE_EPOCH must be non-negative")
    head = subprocess.run(
        ["git", "rev-parse", "--verify", "HEAD^{commit}"],
        cwd=ROOT,
        check=True,
        capture_output=True,
        text=True,
    ).stdout.strip()
    if args.commit != head:
        raise ValueError(f"COMMIT must equal full superproject HEAD {head}, got {args.commit!r}")
    require_clean_superproject()
    built_at = datetime.fromtimestamp(args.source_date_epoch, timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    ldflags = f"-s -w -X {BUILDINFO}.version={args.version} -X {BUILDINFO}.commit={args.commit} -X {BUILDINFO}.builtAt={built_at}"
    base_env = os.environ.copy()
    base_env.update({"CGO_ENABLED": "0", "SOURCE_DATE_EPOCH": str(args.source_date_epoch)})

    # Every gate and staging operation is inside the cleanup boundary. No binary
    # may be built before link/commit/SHA and clean protobuf verification pass.
    succeeded = False
    try:
        run([str(ROOT / "scripts" / "sync-contracts"), "release-check"])
        run([str(ROOT / "scripts" / "check-generated-proto")])
        run([str(ROOT / "scripts" / "stage-contract-assets")])
        run(["go", "test", "-tags", "embedded_contracts", "./internal/contractasset"], base_env)
        for development_output in (ROOT / "build" / "bin", ROOT / "build" / "cross", ROOT / "build" / "container"):
            shutil.rmtree(development_output, ignore_errors=True)
        shutil.rmtree(RELEASE, ignore_errors=True)
        RELEASE.mkdir(parents=True)
        notes = release_notes(args.version, args.commit, built_at)
        (RELEASE / "RELEASE_NOTES.md").write_bytes(notes)
        binaries: dict[tuple[str, str], Path] = {}
        for arch in ("amd64", "arm64"):
            push = RELEASE / f"push-service-linux-{arch}"
            env = base_env | {"GOOS": "linux", "GOARCH": arch}
            run(["go", "build", "-buildvcs=false", "-trimpath", "-ldflags", ldflags, "-o", str(push), "./cmd/push-service"], env)
            PUSH_STAGE.mkdir(parents=True, exist_ok=True)
            shutil.copyfile(push, PUSH_STAGE / "push-service")
            os.chmod(PUSH_STAGE / "push-service", 0o755)
            run(["go", "test", "-tags", "embedded_push", "./internal/pushartifact"], base_env | {"EXPECTED_PUSH_ARCH": arch})
            for os_name in ("darwin", "linux"):
                output = RELEASE / f"tripgoctl-{os_name}-{arch}"
                env = base_env | {"GOOS": os_name, "GOARCH": arch}
                run(["go", "build", "-buildvcs=false", "-tags", "embedded_push,embedded_contracts", "-trimpath", "-ldflags", ldflags, "-o", str(output), "./cmd/tripgoctl"], env)
                os.chmod(output, 0o755)
                binaries[(os_name, arch)] = output

        run([str(ROOT / "scripts" / "check-embedded-push"), "--directory", str(RELEASE)])
        archives = []
        for platform in PLATFORMS:
            os_name, arch = platform
            binary = binaries[platform].read_bytes()
            archive = RELEASE / f"tripgoctl_{args.version}_{os_name}_{arch}.tar.gz"
            create_archive(archive, binary, notes, args.source_date_epoch)
            audit_archive(archive, binary, notes)
            archives.append(archive)
        sums = "".join(f"{sha256(path)}  {path.name}\n" for path in sorted(archives))
        (RELEASE / "SHA256SUMS").write_text(sums)
        for path in binaries.values():
            path.unlink()
        for arch in ("amd64", "arm64"):
            (RELEASE / f"push-service-linux-{arch}").unlink()
        print(f"Created {len(archives)} verified local release archives in {RELEASE.relative_to(ROOT)}")
        succeeded = True
    finally:
        shutil.rmtree(PUSH_STAGE, ignore_errors=True)
        shutil.rmtree(CONTRACT_STAGE, ignore_errors=True)
        if not succeeded:
            shutil.rmtree(RELEASE, ignore_errors=True)
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, ValueError, subprocess.CalledProcessError) as error:
        print(f"release build failed: {error}", file=sys.stderr)
        raise SystemExit(1)
