#!/usr/bin/env python3
"""Stage verified canonical contract bytes for package-local go:embed."""

from __future__ import annotations

import hashlib
import json
import os
import subprocess
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
GENERATED = ROOT / "internal" / "contractasset" / "generated"
ASSETS = {
    ROOT / "api" / "openapi" / "push-service.openapi.yaml": "push-service.openapi.yaml",
    ROOT / "api" / "proto" / "push" / "v1" / "push.proto": "push.proto",
    ROOT / "api" / "source.json": "source.json",
}


def atomic_write(destination: Path, content: bytes) -> None:
    descriptor, name = tempfile.mkstemp(prefix=f".{destination.name}.", dir=destination.parent)
    try:
        with os.fdopen(descriptor, "wb") as output:
            output.write(content)
            output.flush()
            os.fsync(output.fileno())
        os.replace(name, destination)
    finally:
        Path(name).unlink(missing_ok=True)


def main() -> int:
    subprocess.run([str(ROOT / "scripts" / "sync-contracts"), "check"], cwd=ROOT, check=True)
    manifest_content = (ROOT / "api" / "source.json").read_bytes()
    manifest = json.loads(manifest_content)
    hashes = {item["destination"]: item["sha256"] for item in manifest["files"]}
    staged = {}
    for source, name in ASSETS.items():
        content = source.read_bytes()
        if source.name != "source.json":
            destination = str(source.relative_to(ROOT))
            actual = hashlib.sha256(content).hexdigest()
            if hashes.get(destination) != actual:
                raise ValueError(f"canonical contract changed after verification: {destination}")
        staged[name] = content

    GENERATED.mkdir(parents=True, exist_ok=True)
    expected = set(ASSETS.values())
    for stale in GENERATED.iterdir():
        if stale.name not in expected or not stale.is_file() or stale.is_symlink():
            stale.unlink()
    for name, content in staged.items():
        atomic_write(GENERATED / name, content)
    print("Verified canonical contracts staged for release embedding")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
