#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
binary=${PUSH_SERVICE:-"$root/build/bin/push-service"}
work=$(mktemp -d "${TMPDIR:-/tmp}/tripgo-stage7-smoke.XXXXXX")
pid=
cleanup() {
	if [ -n "$pid" ]; then
		kill -TERM "$pid" >/dev/null 2>&1 || true
		wait "$pid" >/dev/null 2>&1 || true
	fi
	rm -rf "$work"
}
trap cleanup EXIT HUP INT TERM

for command in curl go grep jq; do
	if ! command -v "$command" >/dev/null 2>&1; then
		echo "stage7 smoke requires $command" >&2
		exit 3
	fi
done

request='{"request_id":"http-smoke","recipient_id":"8860b315-ec86-42eb-a17c-7c163d721ff5","kind":"REQUEST_POSITION","data":{"trip_id":"1f0a9c62-4a1c-4f2e-9d33-2a4bb0f0b111"}}'

start_service() {
	HTTP_ADDR=127.0.0.1:18090 GRPC_ADDR=127.0.0.1:19095 \
		PUSH_FAIL_RATE=0 PUSH_LATENCY_MS=0 PUSH_RATE_LIMIT_RPS=0 PUSH_RATE_LIMIT_BURST=1 \
		"$binary" >"$work/service.log" 2>&1 &
	pid=$!
	attempt=0
	while [ "$attempt" -lt 50 ]; do
		if curl -fsS http://127.0.0.1:18090/health >/dev/null 2>&1; then
			return 0
		fi
		if ! kill -0 "$pid" 2>/dev/null; then
			cat "$work/service.log" >&2
			return 1
		fi
		attempt=$((attempt + 1))
		sleep 0.1
	done
	echo 'Push Service did not become healthy' >&2
	return 1
}

stop_service() {
	kill -TERM "$pid"
	wait "$pid"
	pid=
}

post_status() {
	url=$1
	body=$2
	curl -sS -o "$work/body" -D "$work/headers" -w '%{http_code}' \
		-H 'Content-Type: application/json' --data-binary "$body" "$url"
}

start_service

test "$(post_status http://127.0.0.1:18090/api/v1/push "$request")" = 202
jq -e '.message_id != "" and .accepted_at != ""' "$work/body" >/dev/null
(cd "$root" && go run ./tests/push-grpc-smoke -endpoint 127.0.0.1:19095 -expect success)

test "$(post_status http://127.0.0.1:18090/api/v1/push '{"unknown":true}')" = 400
test ! -s "$work/body"
test "$(post_status http://127.0.0.1:18090/api/v1/push '{"request_id":null,"recipient_id":"8860b315-ec86-42eb-a17c-7c163d721ff5","kind":"TRIP_CREATED"}')" = 400
test ! -s "$work/body"
test "$(post_status http://127.0.0.1:18090/admin/behaviour '{"fail_rate":null}')" = 400
test ! -s "$work/body"
test "$(curl -sS -o "$work/body" -w '%{http_code}' -H 'Content-Type: text/plain' --data-binary "$request" http://127.0.0.1:18090/api/v1/push)" = 400
test ! -s "$work/body"

test "$(post_status http://127.0.0.1:18090/admin/behaviour '{"fail_rate":1}')" = 200
test "$(post_status http://127.0.0.1:18090/api/v1/push "$request")" = 503
test ! -s "$work/body"
(cd "$root" && go run ./tests/push-grpc-smoke -endpoint 127.0.0.1:19095 -expect unavailable)

test "$(post_status http://127.0.0.1:18090/admin/behaviour '{"fail_rate":0,"latency_ms":1000}')" = 200
(cd "$root" && go run ./tests/push-grpc-smoke -endpoint 127.0.0.1:19095 -timeout 50ms -expect deadline)

test "$(post_status http://127.0.0.1:18090/admin/behaviour '{"latency_ms":0,"rate_limit_rps":1}')" = 200
test "$(post_status http://127.0.0.1:18090/api/v1/push "$request")" = 202
(cd "$root" && go run ./tests/push-grpc-smoke -endpoint 127.0.0.1:19095 -expect resource-exhausted)

test "$(post_status http://127.0.0.1:18090/admin/behaviour '{"rate_limit_rps":0}')" = 200
test "$(post_status http://127.0.0.1:18090/admin/behaviour '{"rate_limit_rps":1}')" = 200
test "$(post_status http://127.0.0.1:18090/api/v1/push "$request")" = 202
test "$(post_status http://127.0.0.1:18090/api/v1/push "$request")" = 429
test ! -s "$work/body"
grep -Fi 'Retry-After: 1' "$work/headers" >/dev/null

stop_service
for result in accepted invalid injected_failure canceled rate_limited; do
	grep -F "\"result\":\"$result\"" "$work/service.log" >/dev/null
done
grep -F '"msg":"Push Service stopped"' "$work/service.log" >/dev/null

# Admin settings are in-memory and reset to env defaults after restart.
start_service
test "$(post_status http://127.0.0.1:18090/api/v1/push "$request")" = 202
stop_service

echo 'stage7 standalone Push Service smoke passed'
