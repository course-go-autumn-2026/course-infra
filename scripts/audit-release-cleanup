#!/usr/bin/env python3
"""Audit release inventory, archive exclusions, staging cleanup, and local runtime state."""

from __future__ import annotations

import hashlib
import shutil
import subprocess
import sys
import tarfile
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
RELEASE = ROOT / "build" / "release"


def fail(message: str) -> None:
    raise ValueError(message)


def main() -> int:
    subprocess.run([str(ROOT / "scripts" / "sync-contracts"), "release-check"], cwd=ROOT, check=True)
    for staging in (ROOT / "internal" / "pushartifact" / "generated", ROOT / "internal" / "contractasset" / "generated"):
        if staging.exists():
            fail(f"ignored build staging was not removed: {staging.relative_to(ROOT)}")
    for path in ROOT.rglob("*"):
        relative = path.relative_to(ROOT)
        if relative.parts[:2] == ("tests", "golden"):
            continue
        if ".git" in relative.parts or "build" in relative.parts or "third_party" in relative.parts:
            continue
        if path.name in (".env", ".tripgo") or path.name.endswith((".tmp", ".swp")):
            fail(f"development state remains: {relative}")
    sums_path = RELEASE / "SHA256SUMS"
    notes_path = RELEASE / "RELEASE_NOTES.md"
    if not sums_path.is_file() or not notes_path.is_file():
        fail("release inventory is incomplete")
    archives = sorted(RELEASE.glob("tripgoctl_*.tar.gz"))
    allowed = {"SHA256SUMS", "RELEASE_NOTES.md", *(path.name for path in archives)}
    actual = {path.name for path in RELEASE.iterdir()}
    if actual != allowed or len(archives) != 4:
        fail(f"unexpected release artifacts: {sorted(actual - allowed)}")
    expected_sums = {}
    for line in sums_path.read_text().splitlines():
        digest, name = line.split("  ", 1)
        expected_sums[name] = digest
    if set(expected_sums) != {path.name for path in archives}:
        fail("SHA256SUMS inventory differs from archives")
    notes = notes_path.read_bytes()
    for archive_path in archives:
        if hashlib.sha256(archive_path.read_bytes()).hexdigest() != expected_sums[archive_path.name]:
            fail(f"checksum mismatch: {archive_path.name}")
        with tarfile.open(archive_path, "r:gz") as archive:
            members = archive.getmembers()
            if [item.name for item in members] != ["tripgoctl", "RELEASE_NOTES.md", "LICENSE"]:
                fail(f"archive includes development-only files: {archive_path.name}")
            if members[0].mode & 0o777 != 0o755:
                fail(f"CLI executable mode is wrong: {archive_path.name}")
            if archive.extractfile(members[1]).read() != notes:  # type: ignore[union-attr]
                fail(f"release notes mismatch: {archive_path.name}")
            if archive.extractfile(members[2]).read() != (ROOT / "LICENSE").read_bytes():  # type: ignore[union-attr]
                fail(f"license mismatch: {archive_path.name}")
    for development_output in (
        ROOT / "build" / "bin",
        ROOT / "build" / "cross",
        ROOT / "build" / "container",
        ROOT / "build" / ".release-check-state",
    ):
        if development_output.exists():
            fail(f"development build output remains: {development_output.relative_to(ROOT)}")
    if shutil.which("docker"):
        result = subprocess.run(
            ["docker", "ps", "-a", "--filter", "name=^/tripgo-local", "--format", "{{.Names}}"],
            capture_output=True,
            text=True,
            check=False,
        )
        if result.returncode == 0 and result.stdout.strip():
            fail("tripgo-local cluster or managed registry container remains")
    print("Release cleanup and archive exclusion audit passed")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, ValueError, subprocess.CalledProcessError) as error:
        print(f"release cleanup audit failed: {error}", file=sys.stderr)
        raise SystemExit(1)
