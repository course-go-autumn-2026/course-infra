{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/course-go-autumn-2026/tripgo-infra/schemas/environment-v1.schema.json",
  "title": "TripGo local environment v1",
  "description": "Formal schema for the data model decoded from environment.toml. TOML syntax is validated before this schema is applied.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "lab",
    "components"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "lab": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "postgres",
          "observability",
          "push",
          "redpanda"
        ]
      }
    },
    "env": {
      "type": "object",
      "description": "Optional literal single-line variables appended to the generated .env. Built-in names cannot be overridden.",
      "propertyNames": {
        "allOf": [
          { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
          {
            "not": {
              "enum": [
                "HTTP_ADDR",
                "LOG_LEVEL",
                "SHUTDOWN_TIMEOUT",
                "DATABASE_URL",
                "DATABASE_MAX_CONNS",
                "DATABASE_MIN_CONNS",
                "DATABASE_MAX_CONN_LIFETIME",
                "DATABASE_CONNECT_TIMEOUT",
                "DATABASE_QUERY_TIMEOUT",
                "OTEL_SERVICE_NAME",
                "OTEL_EXPORTER_OTLP_ENDPOINT",
                "OTEL_EXPORTER_OTLP_PROTOCOL",
                "OTEL_RESOURCE_ATTRIBUTES",
                "OTEL_TRACES_SAMPLER",
                "POSITION_CHECK_INTERVAL",
                "POSITION_STALE_AFTER",
                "POSITION_WORKERS",
                "POSITION_QUEUE_SIZE",
                "PUSH_HTTP_URL",
                "PUSH_REQUEST_TIMEOUT",
                "GRPC_ADDR",
                "PUSH_GRPC_ADDR",
                "BROKER_BROKERS",
                "TRIP_EVENTS_TOPIC",
                "TRIP_COMMANDS_TOPIC",
                "TRIP_COMMANDS_DLQ_TOPIC",
                "CONSUMER_GROUP",
                "PUSH_RETRY_MAX_ATTEMPTS",
                "PUSH_BACKOFF_INITIAL",
                "PUSH_BACKOFF_MAX",
                "PUSH_BACKOFF_MULTIPLIER",
                "PUSH_BACKOFF_JITTER",
                "PUSH_RATE_LIMIT_RPS",
                "PUSH_RATE_LIMIT_BURST",
                "OUTBOX_POLL_INTERVAL",
                "OUTBOX_BATCH_SIZE",
                "CACHE_TTL",
                "CACHE_MAX_ENTRIES",
                "CACHE_SHARDS",
                "WS_WRITE_TIMEOUT",
                "WS_PING_INTERVAL",
                "WS_CLIENT_BUFFER_SIZE"
              ]
            }
          }
        ]
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[^\\u0000\\r\\n]*$"
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "lab": { "const": 1 } }, "required": ["lab"] },
      "then": {
        "properties": {
          "components": {
            "minItems": 1,
            "maxItems": 1,
            "contains": { "const": "postgres" }
          }
        }
      }
    },
    {
      "if": { "properties": { "lab": { "const": 2 } }, "required": ["lab"] },
      "then": {
        "properties": {
          "components": {
            "minItems": 2,
            "maxItems": 2,
            "allOf": [
              { "contains": { "const": "postgres" } },
              { "contains": { "const": "observability" } }
            ]
          }
        }
      }
    },
    {
      "if": { "properties": { "lab": { "const": 3 } }, "required": ["lab"] },
      "then": {
        "properties": {
          "components": {
            "minItems": 3,
            "maxItems": 3,
            "allOf": [
              { "contains": { "const": "postgres" } },
              { "contains": { "const": "observability" } },
              { "contains": { "const": "push" } }
            ]
          }
        }
      }
    },
    {
      "if": { "properties": { "lab": { "enum": [4, 5] } }, "required": ["lab"] },
      "then": {
        "properties": {
          "components": {
            "minItems": 4,
            "maxItems": 4,
            "allOf": [
              { "contains": { "const": "postgres" } },
              { "contains": { "const": "observability" } },
              { "contains": { "const": "push" } },
              { "contains": { "const": "redpanda" } }
            ]
          }
        }
      }
    }
  ]
}
