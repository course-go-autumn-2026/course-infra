apiVersion: v1
kind: ConfigMap
metadata:
  name: otel-collector-config
  namespace: {{ .Namespace }}
  labels:
{{ template "labels4" . }}  annotations:
{{ template "annotations4" . }}data:
  config.yaml: |
    receivers:
      otlp:
        protocols:
          grpc: {endpoint: 0.0.0.0:4317}
          http: {endpoint: 0.0.0.0:4318}
    processors:
      batch: {}
    exporters:
      otlp/jaeger:
        endpoint: jaeger-otlp:4317
        tls: {insecure: true}
      prometheus:
        endpoint: 0.0.0.0:8889
    service:
      pipelines:
        traces: {receivers: [otlp], processors: [batch], exporters: [otlp/jaeger]}
        metrics: {receivers: [otlp], processors: [batch], exporters: [prometheus]}
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: prometheus-config
  namespace: {{ .Namespace }}
  labels:
{{ template "labels4" . }}  annotations:
{{ template "annotations4" . }}data:
  prometheus.yml: |
    global:
      scrape_interval: 5s
    scrape_configs:
      - job_name: otel-collector
        static_configs:
          - targets: [otel-collector-metrics:8889]
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: grafana-provisioning
  namespace: {{ .Namespace }}
  labels:
{{ template "labels4" . }}  annotations:
{{ template "annotations4" . }}data:
  prometheus.yaml: |
    apiVersion: 1
    datasources:
      - name: Prometheus
        uid: prometheus
        type: prometheus
        access: proxy
        url: http://prometheus:9090
        isDefault: true
        editable: false
      - name: Jaeger
        uid: jaeger
        type: jaeger
        access: proxy
        url: http://jaeger:16686
        editable: false
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: otel-collector
  namespace: {{ .Namespace }}
  labels:
{{ template "labels4" . }}  annotations:
{{ template "annotations4" . }}spec:
  replicas: {{ .WorkloadReplicas }}
  selector:
    matchLabels: {app.kubernetes.io/name: otel-collector, app.kubernetes.io/instance: {{ .Namespace }}-otel-collector}
  template:
    metadata:
      labels:
{{ template "labels8" . }}        app.kubernetes.io/name: otel-collector
        app.kubernetes.io/instance: {{ .Namespace }}-otel-collector
      annotations:
{{ template "annotations8" . }}    spec:
      securityContext:
        seccompProfile: {type: RuntimeDefault}
      containers:
        - name: otel-collector
          image: {{ index .Images "otel-collector" }}
          args: [--config=/etc/otelcol/config.yaml]
          ports:
            - {name: otlp-grpc, containerPort: 4317}
            - {name: otlp-http, containerPort: 4318}
            - {name: prometheus, containerPort: 8889}
          readinessProbe:
            tcpSocket: {port: otlp-grpc}
            periodSeconds: 3
          livenessProbe:
            tcpSocket: {port: otlp-grpc}
            initialDelaySeconds: 10
          resources:
            requests: {cpu: 25m, memory: 64Mi}
            limits: {memory: 256Mi}
          securityContext:
            allowPrivilegeEscalation: false
            capabilities: {drop: [ALL]}
            readOnlyRootFilesystem: true
          volumeMounts:
            - {name: config, mountPath: /etc/otelcol, readOnly: true}
      volumes:
        - name: config
          configMap: {name: otel-collector-config}
---
apiVersion: v1
kind: Service
metadata:
  name: otel-collector
  namespace: {{ .Namespace }}
  labels:
{{ template "labels4" . }}  annotations:
{{ template "annotations4" . }}spec:
  type: NodePort
  selector: {app.kubernetes.io/name: otel-collector, app.kubernetes.io/instance: {{ .Namespace }}-otel-collector}
  ports:
    - {name: otlp-grpc, port: 4317, targetPort: otlp-grpc, nodePort: {{ (index .Ports "otel-grpc").NodePort }}}
    - {name: otlp-http, port: 4318, targetPort: otlp-http, nodePort: {{ (index .Ports "otel-http").NodePort }}}
---
apiVersion: v1
kind: Service
metadata:
  name: otel-collector-metrics
  namespace: {{ .Namespace }}
  labels:
{{ template "labels4" . }}  annotations:
{{ template "annotations4" . }}spec:
  type: ClusterIP
  selector: {app.kubernetes.io/name: otel-collector, app.kubernetes.io/instance: {{ .Namespace }}-otel-collector}
  ports:
    - {name: prometheus, port: 8889, targetPort: prometheus}
---
