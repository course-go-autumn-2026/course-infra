apiVersion: v1
kind: Service
metadata:
  name: redpanda
  namespace: {{ .Namespace }}
  labels:
{{ template "labels4" . }}  annotations:
{{ template "annotations4" . }}spec:
  clusterIP: None
  selector: {app.kubernetes.io/name: redpanda, app.kubernetes.io/instance: {{ .Namespace }}-redpanda}
  ports:
    - {name: kafka, port: 9092, targetPort: kafka}
    - {name: admin, port: 9644, targetPort: admin}
---
apiVersion: v1
kind: Service
metadata:
  name: redpanda-external
  namespace: {{ .Namespace }}
  labels:
{{ template "labels4" . }}  annotations:
{{ template "annotations4" . }}spec:
  type: NodePort
  selector: {app.kubernetes.io/name: redpanda, app.kubernetes.io/instance: {{ .Namespace }}-redpanda}
  ports:
    - {name: kafka-external, port: 19092, targetPort: kafka-external, nodePort: {{ (index .Ports "redpanda-kafka").NodePort }}}
---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: redpanda
  namespace: {{ .Namespace }}
  labels:
{{ template "labels4" . }}  annotations:
{{ template "annotations4" . }}spec:
  serviceName: redpanda
  replicas: {{ .WorkloadReplicas }}
  selector:
    matchLabels: {app.kubernetes.io/name: redpanda, app.kubernetes.io/instance: {{ .Namespace }}-redpanda}
  template:
    metadata:
      labels:
{{ template "labels8" . }}        app.kubernetes.io/name: redpanda
        app.kubernetes.io/instance: {{ .Namespace }}-redpanda
      annotations:
{{ template "annotations8" . }}    spec:
      securityContext:
        fsGroup: 101
        seccompProfile: {type: RuntimeDefault}
      containers:
        - name: redpanda
          image: {{ index .Images "redpanda" }}
          args:
            - redpanda
            - start
            - --kafka-addr=internal://0.0.0.0:9092,external://0.0.0.0:19092
            - --advertise-kafka-addr=internal://redpanda:9092,external://localhost:{{ (index .Ports "redpanda-kafka").HostPort }}
            - --rpc-addr=0.0.0.0:33145
            - --advertise-rpc-addr=redpanda-0.redpanda:33145
            - --mode=dev-container
            - --smp=1
            - --memory=512M
            - --reserve-memory=0M
            - --overprovisioned
            - --default-log-level=info
          ports:
            - {name: kafka, containerPort: 9092}
            - {name: kafka-external, containerPort: 19092}
            - {name: admin, containerPort: 9644}
            - {name: rpc, containerPort: 33145}
          readinessProbe: {httpGet: {path: /v1/status/ready, port: admin}, periodSeconds: 3}
          livenessProbe: {httpGet: {path: /v1/status/ready, port: admin}, initialDelaySeconds: 15}
          resources:
            requests: {cpu: 100m, memory: 640Mi}
            limits: {memory: 1Gi}
          securityContext:
            allowPrivilegeEscalation: false
            capabilities: {drop: [ALL]}
          volumeMounts:
            - {name: data, mountPath: /var/lib/redpanda/data}
  volumeClaimTemplates:
    - metadata:
        name: data
        labels:
          app.kubernetes.io/managed-by: tripgoctl
          app.kubernetes.io/part-of: tripgo-local
          tripgo.course/lab: "{{ .LabLabel }}"
          tripgo.course/environment: {{ .Namespace }}
        annotations:
          tripgo.course/cluster-id: {{ printf "%q" .ClusterID }}
      spec:
        accessModes: [ReadWriteOnce]
        resources: {requests: {storage: 2Gi}}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: redpanda-console
  namespace: {{ .Namespace }}
  labels:
{{ template "labels4" . }}  annotations:
{{ template "annotations4" . }}spec:
  replicas: {{ .WorkloadReplicas }}
  selector:
    matchLabels: {app.kubernetes.io/name: redpanda-console, app.kubernetes.io/instance: {{ .Namespace }}-redpanda-console}
  template:
    metadata:
      labels:
{{ template "labels8" . }}        app.kubernetes.io/name: redpanda-console
        app.kubernetes.io/instance: {{ .Namespace }}-redpanda-console
      annotations:
{{ template "annotations8" . }}    spec:
      securityContext:
        runAsNonRoot: true
        runAsUser: 99
        runAsGroup: 99
        seccompProfile: {type: RuntimeDefault}
      containers:
        - name: redpanda-console
          image: {{ index .Images "redpanda-console" }}
          env:
            - {name: KAFKA_BROKERS, value: redpanda:9092}
          ports:
            - {name: http, containerPort: 8080}
          readinessProbe: {httpGet: {path: /admin/health, port: http}, periodSeconds: 3}
          livenessProbe: {httpGet: {path: /admin/health, port: http}, initialDelaySeconds: 10}
          resources:
            requests: {cpu: 20m, memory: 64Mi}
            limits: {memory: 256Mi}
          securityContext:
            allowPrivilegeEscalation: false
            capabilities: {drop: [ALL]}
            readOnlyRootFilesystem: true
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: redpanda-topic-reconciler
  namespace: {{ .Namespace }}
  labels:
{{ template "labels4" . }}  annotations:
{{ template "annotations4" . }}spec:
  replicas: {{ .WorkloadReplicas }}
  selector:
    matchLabels: {app.kubernetes.io/name: redpanda-topic-reconciler, app.kubernetes.io/instance: {{ .Namespace }}-redpanda-topic-reconciler}
  template:
    metadata:
      labels:
{{ template "labels8" . }}        app.kubernetes.io/name: redpanda-topic-reconciler
        app.kubernetes.io/instance: {{ .Namespace }}-redpanda-topic-reconciler
      annotations:
{{ template "annotations8" . }}    spec:
      securityContext:
        runAsNonRoot: true
        runAsUser: 101
        runAsGroup: 101
        seccompProfile: {type: RuntimeDefault}
      containers:
        - name: topic-reconciler
          image: {{ index .Images "redpanda" }}
          command: [/bin/bash, /config/reconcile.sh]
          readinessProbe: {exec: {command: [/bin/test, -f, /tmp/topics-ready]}, periodSeconds: 3}
          resources:
            requests: {cpu: 10m, memory: 32Mi}
            limits: {memory: 128Mi}
          securityContext:
            allowPrivilegeEscalation: false
            capabilities: {drop: [ALL]}
          volumeMounts:
            - {name: config, mountPath: /config, readOnly: true}
            - {name: tmp, mountPath: /tmp}
      volumes:
        - name: config
          configMap:
            name: redpanda-topics
            defaultMode: 0555
        - name: tmp
          emptyDir: {}
---
apiVersion: v1
kind: Service
metadata:
  name: redpanda-console
  namespace: {{ .Namespace }}
  labels:
{{ template "labels4" . }}  annotations:
{{ template "annotations4" . }}spec:
  type: NodePort
  selector: {app.kubernetes.io/name: redpanda-console, app.kubernetes.io/instance: {{ .Namespace }}-redpanda-console}
  ports:
    - {name: http, port: 8080, targetPort: http, nodePort: {{ (index .Ports "redpanda-console").NodePort }}}
