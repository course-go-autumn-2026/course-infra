apiVersion: v1
kind: Secret
metadata:
  name: postgres
  namespace: {{ .Namespace }}
  labels:
{{ template "labels4" . }}  annotations:
{{ template "annotations4" . }}type: Opaque
stringData:
  POSTGRES_DB: tripgo
  POSTGRES_USER: tripgo
  POSTGRES_PASSWORD: tripgo
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: postgres-data
  namespace: {{ .Namespace }}
  labels:
{{ template "labels4" . }}  annotations:
{{ template "annotations4" . }}spec:
  accessModes: [ReadWriteOnce]
  resources:
    requests:
      storage: 1Gi
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: postgres
  namespace: {{ .Namespace }}
  labels:
{{ template "labels4" . }}  annotations:
{{ template "annotations4" . }}spec:
  replicas: {{ .WorkloadReplicas }}
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app.kubernetes.io/name: postgres
      app.kubernetes.io/instance: {{ .Namespace }}-postgres
  template:
    metadata:
      labels:
{{ template "labels8" . }}        app.kubernetes.io/name: postgres
        app.kubernetes.io/instance: {{ .Namespace }}-postgres
      annotations:
{{ template "annotations8" . }}    spec:
      securityContext:
        runAsNonRoot: true
        runAsUser: 70
        runAsGroup: 70
        fsGroup: 70
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: postgres
          image: {{ index .Images "postgres" }}
          imagePullPolicy: IfNotPresent
          envFrom:
            - secretRef:
                name: postgres
          env:
            - name: PGDATA
              value: /var/lib/postgresql/data/pgdata
          ports:
            - name: postgres
              containerPort: 5432
          readinessProbe:
            exec:
              command: [pg_isready, -U, tripgo, -d, tripgo]
            initialDelaySeconds: 2
            periodSeconds: 3
          livenessProbe:
            exec:
              command: [pg_isready, -U, tripgo, -d, tripgo]
            initialDelaySeconds: 10
            periodSeconds: 10
          resources:
            requests:
              cpu: 50m
              memory: 128Mi
            limits:
              memory: 512Mi
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop: [ALL]
          volumeMounts:
            - name: data
              mountPath: /var/lib/postgresql/data
      volumes:
        - name: data
          persistentVolumeClaim:
            claimName: postgres-data
---
apiVersion: v1
kind: Service
metadata:
  name: postgres
  namespace: {{ .Namespace }}
  labels:
{{ template "labels4" . }}  annotations:
{{ template "annotations4" . }}spec:
  type: NodePort
  selector:
    app.kubernetes.io/name: postgres
    app.kubernetes.io/instance: {{ .Namespace }}-postgres
  ports:
    - name: postgres
      protocol: TCP
      port: 5432
      targetPort: postgres
      nodePort: {{ (index .Ports "postgres").NodePort }}
